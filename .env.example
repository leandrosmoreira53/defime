# Chain (Robinhood Chain mainnet)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
DNS_BYPASS=true

# Pool to index (default: public USO/USDG 0.30% pool) and Uniswap NonfungiblePositionManager
POOL_ADDRESS=0x02175608f1b5e6b5ed221ccfdc7be197d111d915
NPM_ADDRESS=0x73991a25C818Bf1f1128dEAaB1492D45638DE0D3
POOL_CREATION_BLOCK=12021761
# Optional: a wallet whose positions you want to follow. Empty = market data only.
WALLET=

# Indexer limits (measured against the public RPC)
CHUNK_SIZE=250000
CONFIRMATIONS=300
MAX_ITEMS_PER_SECOND=35
BATCH_SIZE=25

# Database: SQLite by default; Postgres with postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///defime.db

LOG_LEVEL=INFO
LOG_JSON=true
